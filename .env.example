# Copy to .env.local. All values below are placeholders.

# Public site
NEXT_PUBLIC_SITE_URL=https://vichellinsnation.com
NEXT_PUBLIC_WHATSAPP_NUMBER=234XXXXXXXXXX      # international format, digits only
NEXT_PUBLIC_CONTACT_EMAIL=hello@vichellinsnation.com
NEXT_PUBLIC_PHONE_DISPLAY="+234 000 000 0000"

# Social links (footer shows only the ones that are set)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Supabase. For local development run `npm run stack:up`, which prints these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses all access rules. Used solely by the owner-only Staff page.
# Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
